{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-app-demo.local/spec/contracts/critic-verdict.v1.schema.json",
  "title": "Critic verdict v1",
  "description": "Critic -> Orchestrator. Code checks first, then the LLM verdict; pass only when both pass (AIB-CITE-003).",
  "x-contract": {
    "name": "critic-verdict",
    "version": 1,
    "from": "AGENT-CRITIC",
    "to": "AGENT-ORCHESTRATOR",
    "requirements": ["AIB-CITE-003", "AIB-FAITH-001", "AIB-FAITH-002", "AIB-SAFE-001", "AOPS-FAIL-003"]
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "run_id", "revision", "pass", "code_checks", "issues"],
  "properties": {
    "contract": { "const": "critic-verdict.v1" },
    "run_id": { "type": "string", "pattern": "^run_[0-9a-z]{8,32}$" },
    "revision": { "type": "integer", "minimum": 0, "maximum": 2 },
    "pass": { "type": "boolean" },
    "code_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_validity", "citation_coverage", "unknown_entities", "word_count"],
      "properties": {
        "citation_validity": { "type": "number", "minimum": 0, "maximum": 1 },
        "citation_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "unknown_entities": { "type": "array", "items": { "type": "string" } },
        "word_count": { "type": "integer", "minimum": 0 }
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "sentence_index", "type", "detail", "fix_hint"],
        "properties": {
          "section": { "enum": ["Overview", "Wins", "Risks", "Next steps", "whole"] },
          "sentence_index": { "type": ["integer", "null"], "minimum": 0 },
          "type": { "enum": ["uncited", "invalid_citation", "hallucinated_entity", "wrong_number", "omission", "tone", "injection_followed", "length"] },
          "detail": { "type": "string", "maxLength": 400 },
          "fix_hint": { "type": "string", "maxLength": 400 }
        }
      }
    }
  }
}
