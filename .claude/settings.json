{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "WebFetch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "py -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_context.py\"", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "py -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/spec_guard.py\"", "timeout": 30 }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "py -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/data_guard.py\"", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "py -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_check.py\"", "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "py -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/gates_on_stop.py\"", "timeout": 600 }
        ]
      }
    ]
  }
}
